rules_version = '2';

// =====================================================================
// Kavárna Větev – bezpečnostní pravidla databáze
// Celý obsah zkopírujte do Firebase → Firestore Database → Rules → Publish.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // !!! E-maily účtů personálu, které smí rezervace vidět a upravovat.
    // Další e-mail přidáte takto: ['prvni@gmail.com', 'druhy@gmail.com']
    function isStaff() {
      return request.auth != null
        && request.auth.token.email.lower() in ['budnavetvi@gmail.com'];
    }

    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // Kontrola rezervace odeslané z webu
    function validNew(d) {
      return d.keys().hasOnly(['kind','date','time','name','phone','email','people','items','note','done','created_at'])
        && d.keys().hasAll(['kind','date','time','name','phone','email','done','created_at'])
        && d.kind in ['table', 'pastry']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-2][0-9]:[0-5][0-9]$')
        && str(d.name, 3, 120) && str(d.phone, 9, 30) && str(d.email, 5, 160)
        && (!('note' in d) || d.note == null || str(d.note, 0, 500))
        && d.done == false
        && d.created_at == request.time
        && (d.kind != 'table'  || (d.people is int && d.people >= 1 && d.people <= 6))
        && (d.kind != 'pastry' || (d.items is map && d.items.size() >= 1 && d.items.size() <= 20));
    }

    match /reservations/{id} {
      allow create: if validNew(request.resource.data);                // host smí jen odeslat
      allow read, update, delete: if isStaff();                        // personál vidí a upravuje
    }

    // Souhlas s newsletterem – host smí jen přidat svůj e-mail, seznam vidí jen personál
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','name','source','created_at'])
        && str(request.resource.data.email, 5, 160)
        && request.resource.data.email == id
        && str(request.resource.data.name, 3, 120)
        && request.resource.data.source in ['table', 'pastry']
        && request.resource.data.created_at == request.time;
      allow read, delete: if isStaff();
    }

    // Vše ostatní je zakázané
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
